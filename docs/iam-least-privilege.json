{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrdersTableItemReadWriteOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:548387266019:table/umak-elec3-bcsad-g02-orders"
    },
    {
      "Sid": "LambdaExecutionLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:548387266019:log-group:/aws/lambda/umak-elec3-bcsad-g02-orders-api:*"
    }
  ]
}
